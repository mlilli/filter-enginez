{
  "name": "@filter-enginez/vue-signals",
  "version": "0.0.2",
  "description": "Vue 3 composables for faceted search and filtering: reactive results, counts and filter state from the Filter EngineZ engine.",
  "keywords": [
    "filter-enginez",
    "vue",
    "vue3",
    "composable",
    "composition-api",
    "filter",
    "filtering",
    "faceted-search",
    "facets",
    "search-filters",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": "Michael Lilli",
  "homepage": "https://filterenginez.com",
  "repository": {
    "directory": "packages/vue-signals",
    "type": "git",
    "url": "git+https://github.com/mlilli/filter-enginez.git"
  },
  "bugs": {
    "url": "https://github.com/mlilli/filter-enginez/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "NOTICE.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest --watch=false --passWithNoTests",
    "lint": "eslint --color --no-error-on-unmatched-pattern .",
    "lint:fix": "pnpm prettier:fix && pnpm eslint:fix",
    "eslint:fix": "eslint --color --no-error-on-unmatched-pattern --fix --max-warnings=0 .",
    "prettier:fix": "prettier --write --ignore-path ../../.prettierignore --ignore-unknown ."
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@filter-enginez/core": "workspace:^",
    "@filter-enginez/reactive-signals": "workspace:^"
  },
  "devDependencies": {
    "@filter-enginez/eslint": "workspace:^",
    "vue": "^3.5.40"
  }
}
