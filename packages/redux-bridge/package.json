{
  "name": "@filter-enginez/redux-bridge",
  "version": "0.0.1",
  "description": "Mirror Filter EngineZ filter state into a Redux store: a read-only slice plus middleware, with the engine as the single source of truth. Works with Redux Toolkit.",
  "keywords": [
    "filter-enginez",
    "redux",
    "redux-toolkit",
    "middleware",
    "state-management",
    "filter",
    "filtering",
    "faceted-search",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": "Michael Lilli",
  "homepage": "https://filterenginez.com",
  "repository": {
    "directory": "packages/redux-bridge",
    "type": "git",
    "url": "git+https://github.com/mlilli/filter-enginez.git"
  },
  "bugs": {
    "url": "https://github.com/mlilli/filter-enginez/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "NOTICE.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest --watch=false --passWithNoTests",
    "lint": "eslint --color --no-error-on-unmatched-pattern .",
    "lint:fix": "pnpm prettier:fix && pnpm eslint:fix",
    "eslint:fix": "eslint --color --no-error-on-unmatched-pattern --fix --max-warnings=0 .",
    "prettier:fix": "prettier --write --ignore-path ../../.prettierignore --ignore-unknown ."
  },
  "peerDependencies": {
    "@reduxjs/toolkit": "^2.0.0"
  },
  "dependencies": {
    "@filter-enginez/core": "workspace:^"
  },
  "devDependencies": {
    "@filter-enginez/eslint": "workspace:^"
  }
}
