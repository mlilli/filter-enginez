// Package config for IDEs, `tsc --noEmit` typecheck, and ESLint's typed-lint
// projectService. NON-composite + noEmit, and it INCLUDES test files so they are
// type-checked and resolved to a real program (not the capped default project).
// Declaration emit to `dist` is the job of `tsconfig.build.json` (which excludes tests).
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src/plugin/**/*"],
  "exclude": ["dist", "node_modules", "src/config"]
}
