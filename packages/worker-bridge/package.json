{
  "name": "@filter-enginez/worker-bridge",
  "version": "0.0.2",
  "description": "Run the Filter EngineZ filtering engine in a Web Worker, off the main thread, via Comlink. Engages automatically above 50k items by default.",
  "keywords": [
    "filter-enginez",
    "web-worker",
    "worker",
    "comlink",
    "off-main-thread",
    "performance",
    "filter",
    "filtering",
    "faceted-search",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": "Michael Lilli",
  "homepage": "https://filterenginez.com",
  "repository": {
    "directory": "packages/worker-bridge",
    "type": "git",
    "url": "git+https://github.com/mlilli/filter-enginez.git"
  },
  "bugs": {
    "url": "https://github.com/mlilli/filter-enginez/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "NOTICE.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest --watch=false --passWithNoTests",
    "lint": "eslint --color --no-error-on-unmatched-pattern .",
    "lint:fix": "pnpm prettier:fix && pnpm eslint:fix",
    "eslint:fix": "eslint --color --no-error-on-unmatched-pattern --fix --max-warnings=0 .",
    "prettier:fix": "prettier --write --ignore-path ../../.prettierignore --ignore-unknown ."
  },
  "dependencies": {
    "@filter-enginez/core": "workspace:^",
    "comlink": "^4.4.2"
  },
  "devDependencies": {
    "@filter-enginez/eslint": "workspace:^"
  }
}
