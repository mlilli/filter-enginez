// Composite BUILD config: emits declarations to `dist`, EXCLUDES tests. Referenced by
// the root solution and by other packages' build graphs; driven by `tsc --build`.
// Inherits package-specific compilerOptions from `./tsconfig.json` (DRY).
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*", "src/**/data-real-default.json"],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/**/data-full.json",
    "src/**/data-real-full.json",
    "src/**/data-real-full.ndjson"
  ],
  "references": [
    {
      "path": "../core/tsconfig.build.json"
    }
  ]
}
