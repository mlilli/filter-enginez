{
  "name": "filter-enginez",
  "version": "0.1.0",
  "private": true,
  "description": "Filter EngineZ — generic, isomorphic, framework-agnostic TypeScript data filter engine. Workspace root of the 13 published packages.",
  "author": "Michael Lilli",
  "license": "Apache-2.0",
  "homepage": "https://filterenginez.com",
  "keywords": [
    "data filtering",
    "filter engine",
    "isomorphic",
    "typescript"
  ],
  "type": "module",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "engines": {
    "node": ">=v24.18.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "bench": "turbo run bench",
    "bench:write": "turbo run bench:write",
    "build": "turbo run build",
    "changeset": "changeset",
    "check:node": "node scripts/check-node-version.mjs",
    "clean": "turbo clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "cspell": "cspell lint --cache --cache-location .cache/cspell/.cspellcache --no-must-find-files \"**/*.{cjs,css,html,js,json,jsx,mjs,md,mdx,scss,ts,tsx,yml,yaml}\"",
    "cspell:files": "cspell lint --cache --cache-location .cache/cspell/.cspellcache --no-must-find-files",
    "dev": "turbo run dev",
    "docs:api": "typedoc",
    "lint": "turbo run lint --continue && eslint . --max-warnings=0",
    "lint:fix": "turbo run lint:fix --continue && eslint . --fix --max-warnings=0",
    "lint:markdown": "markdownlint-cli2",
    "lint:markdown:fix": "markdownlint-cli2 --fix",
    "prepare": "husky",
    "prettier:check": "prettier --check --ignore-path ./.prettierignore --ignore-unknown '**/*.{cjs,css,js,json,mjs,md,mdx,scss,ts,yml,yaml}'",
    "prettier:fix": "turbo run prettier:fix --continue",
    "regen:mock-data": "pnpm --filter @filter-enginez/mock-data regen",
    "regen:mock-data:full": "pnpm --filter @filter-enginez/mock-data regen:full",
    "release": "node scripts/sync-licenses.mjs && changeset publish",
    "size": "size-limit",
    "size:json": "size-limit --json",
    "sync:licenses": "node scripts/sync-licenses.mjs",
    "sync:licenses:check": "node scripts/sync-licenses.mjs --check",
    "test": "vitest run",
    "test:changed": "vitest --watch=false --passWithNoTests --changed",
    "test:coverage": "vitest run --coverage",
    "test:min": "vitest --watch=false --passWithNoTests --reporter=dot 2>&1 | grep -E \"FAIL|[0-9]+:[0-9]+$\"",
    "test:ui": "vitest --watch=false --passWithNoTests --ui",
    "test:watch": "vitest --passWithNoTests",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tests/tooling/tsconfig.json",
    "typecheck:build": "tsc --build",
    "version:bump": "node scripts/version-bump.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/config-helpers": "^0.7.0",
    "@filter-enginez/eslint": "workspace:^",
    "@size-limit/preset-small-lib": "^13.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^4.1.11",
    "cspell": "^10.3.6",
    "eslint": "^10.12.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-perfectionist": "^5.12.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "size-limit": "^13.1.1",
    "tinybench": "^6.2.0",
    "turbo": "^2.11.8",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ]
}
