{
  "name": "@filter-enginez/benchmarks",
  "version": "0.0.1",
  "description": "Filter EngineZ — tinybench performance suite over the acceleration-stack matrix. Private, never published.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "tsx src/run.ts",
    "bench:write": "tsx src/run.ts --write",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --color --no-error-on-unmatched-pattern .",
    "lint:fix": "pnpm prettier:fix && pnpm eslint:fix",
    "eslint:fix": "eslint --color --no-error-on-unmatched-pattern --fix --max-warnings=0 .",
    "prettier:fix": "prettier --write --ignore-path ../.prettierignore --ignore-unknown ."
  },
  "devDependencies": {
    "@filter-enginez/core": "workspace:^",
    "@filter-enginez/eslint": "workspace:^",
    "@filter-enginez/mock-data": "workspace:^",
    "tinybench": "^6.0.2",
    "tsx": "^4.23.0"
  }
}
