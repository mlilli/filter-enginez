{
  // The repo's convention is that each root-level test directory owns its program, so ESLint's
  // `projectService` can resolve these files and typed lint rules actually run on them.
  //
  // `types: ["node"]` is the whole point of a separate config. These tests read the
  // filesystem to assert build-configuration invariants, which is exactly why they
  // cannot live inside the packages they describe — the engine packages are isomorphic,
  // and granting one of them Node types to host a test would silently license `node:fs`
  // imports throughout source that must also run in a browser.
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
